<?php
/**
 * Folix game-theme: Product review list with rating summary.
 */

use Magento\Framework\Escaper;
use Magento\Framework\View\Helper\SecureHtmlRenderer;
use Magento\Review\Block\Product\View\ListView;

/**
 * @var ListView $block
 * @var SecureHtmlRenderer $secureRenderer
 * @var Escaper $escaper
 */

$_items = $block->getReviewsCollection()->getItems();
$format = $block->getDateFormat() ?: \IntlDateFormatter::SHORT;
$productId = $block->getProductId();

/** @var \Folix\Review\ViewModel\RatingDistribution|null $distViewModel */
$distViewModel = $block->getData('rating_distribution_view_model');
if ($distViewModel) {
    $distribution = $distViewModel->getDistribution($productId);
    $total = $distribution['total'];
    $average = $distViewModel->getAverage($productId);
}

if (!count($_items) && (!$distViewModel || $total === 0)):
    return;
endif;
?>
<div class="pdp-review-wrapper">
    <?php if ($distViewModel && $total > 0): ?>
    <div class="pdp-review-summary">
        <div class="pdp-review-average">
            <div class="pdp-review-score"><?= $escaper->escapeHtml($average) ?></div>
            <div class="pdp-review-outof"><?= $escaper->escapeHtml(__('out of 5')) ?></div>
            <div class="pdp-review-stars">
                <div class="rating-result"
                     title="<?= $escaper->escapeHtmlAttr($average * 20) ?>%">
                    <span style="width:<?= $escaper->escapeHtmlAttr($average * 20) ?>%">
                        <span><?= $escaper->escapeHtml($average) ?></span>
                    </span>
                </div>
            </div>
            <div class="pdp-review-total">
                <?= $escaper->escapeHtml(__('%1 reviews', (int) $total)) ?>
            </div>
        </div>
        <div class="pdp-review-bars">
            <?php for ($star = 5; $star >= 1; $star--): ?>
            <div class="pdp-review-bar-row">
                <span class="pdp-review-bar-label"><?= $escaper->escapeHtml($star) ?> ★</span>
                <div class="pdp-review-bar-track">
                    <div class="pdp-review-bar-fill" style="width:<?= $escaper->escapeHtmlAttr($distribution[$star]['percent']) ?>%"></div>
                </div>
                <span class="pdp-review-bar-count"><?= $escaper->escapeHtml($distribution[$star]['count']) ?></span>
            </div>
            <?php endfor; ?>
        </div>
    </div>
    <?php endif; ?>

    <?php if (count($_items)): ?>
    <div class="block review-list" id="customer-reviews">
        <div class="block-title">
            <strong><?= $escaper->escapeHtml(__('Customer Reviews')) ?></strong>
        </div>
        <div class="block-content">
            <div class="toolbar review-toolbar">
                <?= $block->getChildHtml('toolbar') ?>
            </div>
            <ol class="items review-items">
                <?php foreach ($_items as $_review): ?>
                    <li class="item review-item" itemscope itemprop="review" itemtype="http://schema.org/Review">
                        <div class="review-item-rating">
                            <?php
                            $_votes = $_review->getRatingVotes();
                            if ($_votes && $_votes->getSize()):
                                $_firstVote = $_votes->getFirstItem();
                            ?>
                                <div class="rating-result"
                                     title="<?= $escaper->escapeHtmlAttr($_firstVote->getPercent()) ?>%">
                                    <span style="width:<?= $escaper->escapeHtmlAttr($_firstVote->getPercent()) ?>%;">
                                        <span><?= $escaper->escapeHtmlAttr($_firstVote->getPercent()) ?>%</span>
                                    </span>
                                </div>
                            <?php endif; ?>
                        </div>
                        <div class="review-item-content">
                            <div class="review-title" itemprop="name">
                                <?= $escaper->escapeHtml($_review->getTitle()) ?>
                            </div>
                            <div class="review-content" itemprop="description">
                                <?= /* @noEscape */ nl2br($escaper->escapeHtml($_review->getDetail())) ?>
                            </div>
                            <div class="review-details">
                                <span class="review-author" itemprop="author">
                                    <?= $escaper->escapeHtml($_review->getNickname()) ?>
                                </span>
                                <time class="review-date" itemprop="datePublished"
                                      datetime="<?= $escaper->escapeHtmlAttr($block->formatDate($_review->getCreatedAt(), $format)) ?>">
                                    <?= $escaper->escapeHtml($block->formatDate($_review->getCreatedAt(), $format)) ?>
                                </time>
                            </div>
                        </div>
                    </li>
                <?php endforeach; ?>
            </ol>
            <div class="toolbar review-toolbar">
                <?= $block->getChildHtml('toolbar') ?>
            </div>
        </div>
    </div>
    <?php endif; ?>
</div>
