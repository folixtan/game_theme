<?xml version="1.0"?>
<!--
/**
 * Folix Game Theme - Product View Layout
 *
 * 产品详情页布局 - 60/40 两列布局
 * 通过 move 指令重新组织现有 blocks
 */
-->
<page layout="1column" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
      
        <!-- 创建产品详情主容器 -->
        <referenceContainer name="content">
            <!-- 产品详情主容器 - 用于 60/40 布局 -->
            <container name="product.detail.wrapper" htmlTag="div" htmlClass="product-info-wrapper" before="-">
                <!-- 左列 60% - 产品图片 + Tabs -->
                <container name="product.detail.view.info" htmlTag="div" htmlClass="product-form-container" />
                   
                 <container name="product.detail.view.wrapper" htmlTag="div" htmlClass="product-details-wrapper">
                    <!-- 左 70% - Tabs -->
                    <!-- 右 30% - Related/Upsell -->
                    <container name="product.sidebar.wrapper" htmlTag="div" htmlClass="pdp-sidebar-panel" />
                 </container>
            
             </container>
            
        </referenceContainer>
       
       
        <referenceContainer name="product.detail.view.info">

              <block class="Magento\Catalog\Block\Product\View" name="product.info" template="Magento_Catalog::product/view/form.phtml" after="product.info.media">
                           <container name="product.info.main.wrapper" htmlTag="div" htmlClass="product-main-contiainer" /> 
                            <container name="product.info.form.content" as="product_info_form_content" />
                           
                            <block class="Magento\Framework\View\Element\Template" name="product.info.form.options" as="options_container">
                                <block class="Magento\Catalog\Block\Product\View" name="product.info.options.wrapper" as="product_options_wrapper" template="Magento_Catalog::product/view/options/wrapper.phtml">
                                    <block class="Magento\Catalog\Block\Product\View\Options" name="product.info.options" as="product_options" template="Magento_Catalog::product/view/options.phtml">
                                        <block class="Magento\Catalog\Block\Product\View\Options\Type\DefaultType" name="product.info.options.default" as="default" template="Magento_Catalog::product/view/options/type/default.phtml"/>
                                        <block class="Magento\Catalog\Block\Product\View\Options\Type\Text" name="product.info.options.text" as="text" template="Magento_Catalog::product/view/options/type/text.phtml"/>
                                        <block class="Magento\Catalog\Block\Product\View\Options\Type\File" name="product.info.options.file" as="file" template="Magento_Catalog::product/view/options/type/file.phtml"/>
                                        <block class="Magento\Catalog\Block\Product\View\Options\Type\Select" name="product.info.options.select" as="select" template="Magento_Catalog::product/view/options/type/select.phtml"/>
                                        <block class="Magento\Catalog\Block\Product\View\Options\Type\Date" name="product.info.options.date" as="date" template="Magento_Catalog::product/view/options/type/date.phtml"/>
                                    </block>
                                    <block class="Magento\Framework\View\Element\Html\Calendar" name="html_calendar" as="html_calendar" template="Magento_Theme::js/calendar.phtml"/>
                                </block>
                            </block>
                            <block class="Magento\Catalog\Block\Product\View" name="product.info.options.wrapper.bottom" as="product_options_wrapper_bottom" template="Magento_Catalog::product/view/options/wrapper/bottom.phtml">
                                    <block class="Magento\Catalog\Block\Product\View" name="product.info.addtocart.additional" as="product.info.addtocart" template="Magento_Catalog::product/view/addtocart.phtml"/>
                            </block>
                </block>
        </referenceContainer>
           <!-- 移动原生 blocks 到新容器 -->
         
        <!-- 移动产品图片区域到左侧（原生的 product.info.media 是 container，包含 Gallery） -->
        <move element="product.info.media" destination="product.info.main.wrapper" before="-"/>
        <!-- 移动产品标题到右侧 -->
        <move element="page.main.title" destination="product.info.main.wrapper" after="product.info.media"/>
       

    <referenceBlock name="product.info" >
        <container name="product.form.chage.template" htmlTag="div" htmlClass="product-form-change-template" />
        

    </referenceBlock>
    <referenceBlock name="product.price.final">
         <arguments>
            <argument name="price_render" xsi:type="string">product.price.render.default</argument>
            <argument name="price_type_code" xsi:type="string">final_price</argument>
            <argument name="zone" xsi:type="string">cart</argument>
        </arguments>
    </referenceBlock>
     <move element="product.info.extrahint" destination="product.info.options.wrapper.bottom" after="-" />
     <move element="product.info.overview" destination="page.main.title" after="-" />
     <move element="product.info.review" destination="page.main.title" before="product.info.overview" />
      <move element="product.info.main" destination="product.info" before="product.form.chage.template" />
        <!-- 移动产品详情 Tabs 到左侧（在 Gallery 之后） -->
        <move element="product.info.details" destination="product.detail.view.wrapper" before="-" />
        <move element="content.aside" destination="product.sidebar.wrapper" after="-" />
    </body>
</page>
